{
  "name": "wordwell-intake-adjudication",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "PROTOTYPE (issue #46) \u2014 morphology adjudication runner and evaluation harness. Throwaway: no schema, no migrations, no pipeline integration.",
  "scripts": {
    "adjudicate": "dotenv -e .env.local -- tsx src/cli.ts",
    "propose": "CASE_SET=calibration-review dotenv -e .env.local -- tsx src/cli.ts",
    "eval": "dotenv -e .env.local -- braintrust eval evals/contract.eval.ts",
    "smoke": "CASE_SET=prompt-smoke dotenv -e .env.local -- braintrust eval evals/contract.eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "models": "dotenv -e .env.local -- tsx src/models-cli.ts",
    "review:build": "tsx src/review-cli.ts",
    "review:import": "tsx src/import-review-progress.ts",
    "usefulness": "dotenv -e .env.local -- tsx src/usefulness-cli.ts",
    "eval:usefulness": "dotenv -e .env.local -- braintrust eval evals/usefulness.eval.ts",
    "report": "tsx src/report-usefulness.ts",
    "report:html": "tsx src/report-exam-html.ts",
    "report:v10": "tsx src/report-v10-html.ts",
    "report:v11": "PROMPT_NUMBER=11 tsx src/report-v10-html.ts",
    "report:v12": "PROMPT_NUMBER=12 REPORT_DATASETS=golden tsx src/report-v10-html.ts",
    "report:v13": "PROMPT_NUMBER=13 tsx src/report-headword-html.ts",
    "report:v14": "PROMPT_NUMBER=14 tsx src/report-headword-html.ts",
    "report:v14:audit": "PROMPT_NUMBER=14 REPORT_DATASETS=retention-audit-v1 tsx src/report-headword-html.ts",
    "report:v15": "tsx src/report-audience-risk-html.ts",
    "review:risk-stress": "tsx scripts/render-stress-review.ts",
    "report:compare-v9-v13": "tsx src/report-v9-v13-comparison-html.ts",
    "report:compare-v13-v14": "tsx src/report-v13-v14-comparison-html.ts",
    "experiment:v11": "PROMPT_NUMBER=11 dotenv -e .env.local -- tsx src/teaching-value-ablation-cli.ts",
    "experiment:v12": "PROMPT_NUMBER=12 dotenv -e .env.local -- tsx src/teaching-value-ablation-cli.ts",
    "experiment:v13": "PROMPT_NUMBER=13 dotenv -e .env.local -- tsx src/headword-teaching-value-cli.ts",
    "experiment:v14": "PROMPT_NUMBER=14 dotenv -e .env.local -- tsx src/headword-teaching-value-cli.ts",
    "experiment:v15": "CASE_SET=risk-cohort-v1 dotenv -e .env.local -- tsx src/audience-risk-v15-cli.ts",
    "audit": "dotenv -e .env.local -- tsx src/audit-cli.ts"
  },
  "dependencies": {
    "openai": "^7.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "braintrust": "^3.7.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
