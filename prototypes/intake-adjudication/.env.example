# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key,
# and never paste one into a chat, a shell command, an issue, a trace or a dataset.
#
#   cp .env.example .env.local

# Prepaid, project-scoped OpenRouter key with auto-recharge OFF.
# Create at https://openrouter.ai/settings/keys with a credit limit, not an
# account-wide key. The pilot budget for the whole of issue #46 is $10.
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Exact model identifier. No default: "whatever the default is" is an unrecorded
# variable. `npm run models` lists what OpenRouter currently serves with
# structured output support, cheapest first.
OPENROUTER_MODEL=replace-me

# REQUIRED. The upstream that actually serves the model. Stage 1 measured what
# leaving this blank costs: five calls served by four different upstreams gave
# two different verdicts under one fingerprint, at a 4.9x cost spread. The same
# model is served by 22 upstreams at prices spanning 14x.
#   npm run models -- <model-id>   lists them; pin one.
OPENROUTER_PROVIDER=replace-me

# Sampling. Leave at 0 unless an experiment is deliberately varying it.
OPENROUTER_TEMPERATURE=0
OPENROUTER_SEED=

# Free signup at https://www.braintrust.dev — experiment tracing and scores.
BRAINTRUST_API_KEY=replace-me
